{
  "config": {
    "step": {
      "user": {
        "title": "HiveFW",
        "description": "Configure HiveFW directly with your Companion/Repeater over TCP/Wi-Fi, BLE or USB. HiveFW owns the radio connection, Home Assistant entities, services, chat, channels, nodes, telemetry and diagnostics; no separate MeshCore Home Assistant integration is required."
      }
    },
    "abort": {
      "single_instance_allowed": "HiveFW is already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "HiveFW HA Integration options",
        "description": "Tune how long the message store retains conversation history. Changes take effect on the next message save and at the next Home Assistant restart.",
        "data": {
          "max_messages_per_conversation": "Max messages per conversation",
          "message_retention_days": "Message retention (days)"
        },
        "data_description": {
          "max_messages_per_conversation": "When a conversation exceeds this number, the oldest messages are trimmed first. Range: 50 – 5000. Default: 500.",
          "message_retention_days": "Messages older than this are pruned at startup and during periodic cleanup. Range: 1 – 365. Default: 90."
        }
      }
    }
  },
  "issues": {
    "radio_engine_unavailable": {
      "title": "HiveFW radio connection is unavailable",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "HiveFW cannot reach the configured radio",
            "description": "HiveFW owns the radio connection directly. Check the configured TCP/Wi-Fi, BLE or USB connection and reload the integration. No separate MeshCore Home Assistant integration is required."
          }
        }
      }
    },
    "name_changed": {
      "title": "HiveFW device renamed",
      "description": "The HiveFW device was renamed from `{old_name}` to `{new_name}`. {count} entity IDs were automatically migrated from the `_{old_suffix}` suffix to `_{new_suffix}`.\n\n**Renamed entities:**\n\n{entity_list}\n\nIf you have automations, scripts, or dashboards referencing the old entity IDs, you will need to update them manually to use the new suffix.\n\nThis issue can be dismissed once you have verified your configuration."
    }
  },
  "exceptions": {
    "operation_failed": {
      "message": "Operation failed"
    },
    "device_not_connected": {
      "message": "Device not connected"
    },
    "operation_timed_out": {
      "message": "Operation timed out"
    },
    "invalid_request": {
      "message": "Invalid request parameters"
    },
    "no_hivefw_coordinator": {
      "message": "No active HiveFW radio coordinator"
    },
    "invalid_key_length": {
      "message": "Private key must be 64 or 128 hex characters"
    },
    "invalid_key_hex": {
      "message": "Private key must contain only hex characters (0-9, a-f)"
    },
    "import_rejected": {
      "message": "The device firmware rejected the new identity. The device's identity is unchanged."
    },
    "verify_failed": {
      "message": "The new identity did not take effect on the device. The device's identity may be unchanged."
    }
  },
